  "info": {
    "title": "ProbashOS API",
    "description": "Safe migration and global opportunity platform API.\n\nGuarantees this API is built to keep:\n- eligibility answers are deterministic and source-backed, and \"unknown\" is a real answer;\n- a verification level is derived from checked facts, never asserted;\n- money moves only on provider-confirmed webhooks, and settles only against verified milestones;\n- synthetic development records are labelled and are not served outside development.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "identity",
      "description": "Phone OTP onboarding, profile and Skill Passport (§17, §18)"
    },
    {
      "name": "catalogue",
      "description": "Countries, routes, occupations and their official sources (§7, §9, §38)"
    },
    {
      "name": "eligibility",
      "description": "Deterministic eligibility with a decision trace (§19, §48)"
    },
    {
      "name": "jobs",
      "description": "Verified jobs and public verification (§21)"
    },
    {
      "name": "scanner",
      "description": "Offer / visa / document scanner (§23)"
    },
    {
      "name": "cases",
      "description": "Application workflow, tasks, milestones and cost plan (§24, §33)"
    },
    {
      "name": "payments",
      "description": "Milestone-controlled settlement and the double-entry ledger (§25)"
    },
    {
      "name": "documents",
      "description": "Document wallet and consented sharing (§29)"
    },
    {
      "name": "delegations",
      "description": "Family co-pilot (§28)"
    }
  ],
