{
  "name": "probash-os",
  "private": true,
  "version": "0.1.0",
  "description": "Safe migration and global opportunity operating system (working codename ProbashOS). Brand name is configurable, never hard-coded.",
  "packageManager": "pnpm@11.22.0",
  "workspaces": [
    "packages/domain",
    "packages/design-tokens",
    "packages/analytics",
    "packages/config",
    "packages/contracts",
    "packages/auth",
    "packages/i18n",
    "packages/ledger",
    "packages/rules",
    "packages/testing",
    "packages/web-ui",
    "apps/api",
    "apps/ops-desktop",
    "apps/web",
    "apps/document-worker",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@probash/domain --workspace=@probash/design-tokens --workspace=@probash/analytics --workspace=@probash/config --workspace=@probash/contracts --workspace=@probash/auth --workspace=@probash/i18n --workspace=@probash/ledger --workspace=@probash/rules --workspace=@probash/testing --workspace=@probash/web-ui --workspace=@probash/api --workspace=@probash/web --workspace=@probash/document-worker --if-present",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter='./packages/*'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter @probash/api seed",
    "db:migrate": "pnpm --filter @probash/api db:migrate",
    "services:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker/docker-compose.yml down",
    "e2e:web": "pnpm --filter @probash/web test:e2e",
    "smoke:built": "node scripts/smoke-built.mjs",
    "release:gate": "node scripts/verify-release-gate.mjs",
    "migration:inventory": "node scripts/migration/create-inventory.mjs",
    "migration:reconcile": "node scripts/migration/reconcile-inventories.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "@eslint/js": "^10.0.1"
  }
}
