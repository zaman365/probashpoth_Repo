# ---------------------------------------------------------------------------
# ProbashOS (working codename) — example environment.
# Do NOT commit real secrets. Provider-specific secrets live in a secret manager.
# ---------------------------------------------------------------------------

# App
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
PORT=3001
DEFAULT_LOCALE=bn-BD
# Brand name is configurable on purpose — never hard-code it in code or copy.
PUBLIC_PRODUCT_NAME=ProbashJatra
PUBLIC_PRODUCT_NAME_BN=প্রবাসযাত্রা

# Storage driver for the API: memory | postgres
# `postgres` uses the durable adapter and requires the migrated schema (ADR 0001).
STORAGE_DRIVER=memory

# DB
DATABASE_URL=postgres://probash:probash@localhost:5432/probash
REDIS_URL=redis://localhost:6379
# Development-only example. Production must use a KMS-managed, independently rotated key.
FIELD_ENCRYPTION_KEY=cHJvYmFzaC1kZXYtZmllbGQta2V5LTMyLWJ5dGVzISE=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=probash-documents
S3_ACCESS_KEY_ID=probash
S3_SECRET_ACCESS_KEY=probash-dev-secret
KMS_KEY_ID=

# IAM
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Dev-only session signing key. Replace in every non-development environment.
SESSION_SIGNING_KEY=dev-only-session-key-change-me
# Signing key for public verification QR tokens (§21). Rotate via key id.
QR_SIGNING_KEY=dev-only-qr-key-change-me
QR_SIGNING_KEY_ID=dev-1

# Notifications
SMS_PROVIDER=console
SMS_API_KEY=
PUSH_PROVIDER=console

# AI (explanatory only — never authoritative, never upgrades a verification level)
LLM_PROVIDER=
LLM_API_KEY=
STT_PROVIDER=
TTS_PROVIDER=

# Payments (mock only until a licensed provider is contractually onboarded — ADR 0004)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Regulatory fetch
REGULATORY_FETCH_USER_AGENT=ProbashOS-RegulatoryFetcher/0.1 (+contact@example.org)
