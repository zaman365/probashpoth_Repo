{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bdos-web-staging",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [{ "pattern": "staging.bdos.io", "custom_domain": true }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID" }],
  "r2_buckets": [
    { "binding": "DOCUMENTS_QUARANTINE", "bucket_name": "bdos-staging-documents-quarantine" },
    { "binding": "DOCUMENTS_CLEAN", "bucket_name": "bdos-staging-documents-clean" },
  ],
  "queues": {
    "producers": [{ "binding": "DOCUMENT_SCAN_QUEUE", "queue": "bdos-staging-document-scan" }],
  },
  "vars": {
    "APP_ENV": "staging",
    "IDENTITY_PROVIDER": "clerk",
    "CLERK_PUBLISHABLE_KEY": "REPLACE_WITH_STAGING_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "REPLACE_WITH_STAGING_PUBLISHABLE_KEY",
    "CLERK_AUTHORIZED_PARTIES": "https://staging.bdos.io",
    "CLERK_SIGN_IN_URL": "/sign-in",
    "CLERK_SIGN_UP_URL": "/sign-up",
    "STORAGE_DRIVER": "postgres",
    "DATA_RESIDENCY_REGION": "eu",
    "DOCUMENT_UPLOADS_ENABLED": "false",
    "DOCUMENT_QUARANTINE_ENABLED": "true",
    "DOCUMENT_MALWARE_SCANNING_ENABLED": "false",
    "DOCUMENT_DOWNLOAD_AUDIT_ENABLED": "true",
    "SECURITY_GATE_S3_APPROVED": "false",
  },
}
