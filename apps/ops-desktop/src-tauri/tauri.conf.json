{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProbashOS Desk",
  "version": "0.1.0",
  "identifier": "org.probash.desk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [{ "title": "ProbashOS Desk", "width": 1200, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3001; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
