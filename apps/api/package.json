{
  "name": "@probash/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "node -r @swc-node/register src/storage/seed/verify-seed.ts",
    "openapi": "node -r @swc-node/register src/openapi.ts",
    "db:migrate": "node -r @swc-node/register src/storage/postgres/migrate.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.2.0",
    "@probash/analytics": "workspace:*",
    "@probash/auth": "workspace:*",
    "@probash/config": "workspace:*",
    "@probash/contracts": "workspace:*",
    "@probash/domain": "workspace:*",
    "@probash/i18n": "workspace:*",
    "@probash/ledger": "workspace:*",
    "@probash/rules": "workspace:*",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@probash/testing": "workspace:*",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.11"
  }
}
