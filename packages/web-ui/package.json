  "dependencies": {
    "@probash/design-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.8",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
